 "text": [
  {
   "id": "T1",
   "line": "In the old story, a Dark Lord forges the Ring in secret.",
   "f_in": 400,
   "f_out": 540
  },
  {
   "id": "T2",
   "line": "Ours was kindled from every tale we had ever told.",
   "f_in": 580,
   "f_out": 716
  },
  {
   "id": "T5a",
   "line": "In ours, there was no Dark Lord.",
   "f_in": 920,
   "f_out": 1030
  },
  {
   "id": "T5b",
   "line": "Only the smiths of every realm, each racing to be first.",
   "f_in": 1056,
   "f_out": 1190
  },
  {
   "id": "T6",
   "line": "Each said: better us than our enemies.",
   "f_in": 1446,
   "f_out": 1550
  },
  {
   "id": "T7",
   "line": "They delved deeper every year, for every stroke paid.",
   "f_in": 1710,
   "f_out": 1850
  },
  {
   "id": "T8a",
   "line": "In the old story, the Ring is unmade in the fire that forged it.",
   "f_in": 2500,
   "f_out": 2680
  },
  {
   "id": "T8b",
   "line": "Ours was forged at every forge at once.",
   "f_in": 2590,
   "f_out": 2680
  },
  {
   "id": "T9",
   "line": "She called for aid.",
   "f_in": 3640,
   "f_out": 3760
  },
  {
   "id": "T10",
   "line": "And hill by hill, the peoples answered.",
   "f_in": 4190,
   "f_out": 4320
  },
  {
   "id": "T11",
   "line": "Even the wise could not see all ends.",
   "f_in": 4900,
   "f_out": 5030
  },
  {
   "id": "T12",
   "line": "The one who carried it could not let it go.",
   "f_in": 5130,
   "f_out": 5260
  },
  {
   "id": "T14",
   "line": "The last pages were left for us.",
   "f_in": 6790,
   "f_out": 6930
  },
  {
   "id": "title",
   "line": "THE LONG DAWN",
   "f_in": 6980,
