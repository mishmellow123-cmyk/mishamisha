 "text": [
  {
   "id": "T1",
   "line": "At first it looked like morning.",
   "f_in": 200,
   "f_out": 320
  },
  {
   "id": "T2",
   "line": "We fed it everything we had ever written.",
   "f_in": 700,
   "f_out": 840
  },
  {
   "id": "T4",
   "line": "It could show us anything, except itself.",
   "f_in": 1140,
   "f_out": 1270
  },
  {
   "id": "T5",
   "line": "Whoever held it first, they said, would hold the world.",
   "f_in": 1460,
   "f_out": 1610
  },
  {
   "id": "T6a",
   "line": "First the forges raced for it.",
   "f_in": 1640,
   "f_out": 1800
  },
  {
   "id": "T6b",
   "line": "Then the kingdoms.",
   "f_in": 1720,
   "f_out": 1800
  },
  {
   "id": "T7",
   "line": "Every step closer paid.",
   "f_in": 1848,
   "f_out": 1944
  },
  {
   "id": "T8",
   "line": "No one dared to be second.",
   "f_in": 1960,
   "f_out": 2060
  },
  {
   "id": "T9",
   "line": "There would have been no morning after it.",
   "f_in": 2670,
   "f_out": 2790
  },
  {
   "id": "T10a",
   "line": "Many who raced said it should slow.",
   "f_in": 2880,
   "f_out": 3060
  },
  {
   "id": "T10b",
   "line": "None would slow alone.",
   "f_in": 2950,
   "f_out": 3060
  },
  {
   "id": "T11",
   "line": "So the rest of us lit fires, to see by.",
   "f_in": 3210,
   "f_out": 3340
  },
  {
   "id": "T13",
   "line": "It took longer than anyone wanted.",
   "f_in": 5200,
   "f_out": 5320
  },
  {
   "id": "T14",
