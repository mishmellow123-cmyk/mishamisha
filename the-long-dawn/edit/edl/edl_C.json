 "text": [
  {
   "id": "R02",
   "line": "In the old story, a Dark Lord forges a Ring to rule the world.",
   "f_in": 400,
   "f_out": 540,
   "set": "in_picture",
   "locked": null,
   "row": 2
  },
  {
   "id": "R03",
   "line": "Our Ring was kindled from every tale we had ever told.",
   "f_in": 580,
   "f_out": 716,
   "set": "fire",
   "locked": null,
   "row": 3
  },
  {
   "id": "R04",
   "line": "It read every word we had ever written, and learned to answer.",
   "f_in": 728,
   "f_out": 856,
   "set": "fire",
   "locked": null,
   "row": 4
  },
  {
   "id": "R05",
   "line": "In our story, there was no Dark Lord.",
   "f_in": 920,
   "f_out": 1030,
   "set": "fire",
   "locked": null,
   "row": 5
  },
  {
   "id": "R06",
   "line": "Only smiths in every kingdom, each racing to finish it first.",
   "f_in": 1056,
   "f_out": 1190,
   "set": "fire",
   "locked": null,
   "row": 6
  },
  {
   "id": "R07",
   "line": "Each said: better us than them.",
   "f_in": 1446,
   "f_out": 1550,
   "set": "fire",
   "locked": null,
   "row": 7
  },
  {
   "id": "R08",
   "line": "They dug deeper every year, for the gold ran deeper still.",
   "f_in": 1710,
   "f_out": 1850,
   "set": "ink",
   "locked": null,
   "row": 8
  },
  {
   "id": "R09",
   "line": "But whoever won the race, the Ring would rule us all.",
   "f_in": 1972,
   "f_out": 2076,
   "set": "fire",
   "locked": null,
   "row": 9
  },
  {
   "id": "R10",
   "line": "In the old story, the wise refused the Ring.",
   "f_in": 2168,
   "f_out": 2306,
   "set": "ink",
   "locked": null,
   "row": 10,
   "x": 1065
  },
  {
   "id": "R11",
   "line": "In ours, no smith could refuse it alone.",
   "f_in": 2452,
   "f_out": 2572,
   "set": "fire",
   "locked": null,
   "row": 11,
   "y": 330
  },
  {
   "id": "R13",
   "line": "So the two furthest ahead lit the first beacons, together.",
   "f_in": 2900,
   "f_out": 3040,
   "set": "ink",
   "locked": null,
   "row": 13,
   "y": 150
  },
  {
   "id": "R14",
   "line": "It was a promise to stop, if all the others would.",
   "f_in": 3160,
   "f_out": 3300,
   "set": "ink",
   "locked": null,
   "row": 14,
   "y": 150
  },
  {
   "id": "R15",
   "line": "When the last beacon caught, every forge went cold.",
   "f_in": 3740,
   "f_out": 3836,
   "set": "fire",
   "locked": null,
   "row": 15,
   "y": 220
  },
  {
   "id": "R17",
   "line": "The Ring hung there, unfinished.",
   "f_in": 4040,
   "f_out": 4180,
   "set": "fire",
   "locked": null,
   "row": 17
  },
  {
   "id": "R18",
   "line": "They left the gold in the ground.",
   "f_in": 4276,
   "f_out": 4416,
   "set": "ink",
   "locked": null,
   "row": 18,
   "x": 310,
   "y": 300,
   "lines": [
    "They left the gold",
    "in the ground."
   ]
  },
  {
   "id": "R19",
   "line": "And the beacons burned on, so no forge could be lit in secret.",
   "f_in": 4504,
   "f_out": 4664,
   "set": "ink",
   "locked": null,
   "row": 19,
   "y": 150
  },
  {
   "id": "R20",
   "line": "Without the Ring, the dawn came slowly. But it came.",
   "f_in": 4860,
   "f_out": 5020,
   "set": "ink",
   "locked": null,
   "row": 20,
   "y": 150
  },
  {
   "id": "R22",
   "line": "The last pages were left for us.",
   "f_in": 5462,
   "f_out": 5602,
   "set": "ink",
   "locked": null,
   "row": 22,
   "x": 440,
   "y": 520
  },
  {
   "id": "title",
   "line": "THE LONG DAWN",
   "f_in": 5700,
   "f_out": 5880,
   "set": "in_picture",
   "locked": null,
   "row": 23
  }
 ],
