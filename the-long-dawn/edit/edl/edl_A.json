 "text": [
  {
   "id": "T1",
   "line": "At first it looked like morning.",
   "f_in": 200,
   "f_out": 320,
   "set": "lower",
   "locked": "At first it looked like morning."
  },
  {
   "id": "T2",
   "line": "We fed it everything we knew.",
   "f_in": 700,
   "f_out": 840,
   "set": "lower",
   "locked": "We fed it everything we had ever written."
  },
  {
   "id": "T4",
   "line": "It could show us anything, except itself.",
   "f_in": 1140,
   "f_out": 1270,
   "set": "lower",
   "locked": "It could show us anything, except itself."
  },
  {
   "id": "T5",
   "line": "Whoever held it first, they said, would hold the world.",
   "f_in": 1460,
   "f_out": 1610,
   "set": "lower",
   "locked": "Whoever held it first, they said, would hold the world.",
   "x": 440,
   "y": 600,
   "lines": [
    "Whoever held it first, they said,",
    "would hold the world."
   ]
  },
  {
   "id": "T6a",
   "line": "First the smiths raced for it.",
   "f_in": 1640,
   "f_out": 1800,
   "set": "lower",
   "locked": "First the forges raced for it.",
   "x": 440,
   "y": 600
  },
  {
   "id": "T6b",
   "line": "Then the kingdoms.",
   "f_in": 1720,
   "f_out": 1800,
   "set": "lower",
   "locked": "Then the kingdoms.",
   "x": 440,
   "y": 680
  },
  {
   "id": "T7",
   "line": "Every step closer made them richer.",
   "f_in": 1848,
   "f_out": 1944,
   "set": "lower",
   "locked": "Every step closer paid.",
   "x": 1600,
   "y": 648,
   "lines": [
    "Every step closer",
    "made them richer."
   ]
  },
  {
   "id": "T8",
   "line": "No one dared to be second.",
   "f_in": 1960,
   "f_out": 2060,
   "set": "lower",
   "locked": "No one dared to be second.",
   "x": 1600,
   "y": 648,
   "lines": [
    "No one dared",
    "to be second."
   ]
  },
  {
   "id": "T9",
   "line": "Whoever won, no morning would come.",
   "f_in": 2670,
   "f_out": 2790,
   "set": "lower",
   "locked": "There would have been no morning after it.",
   "x": 960,
   "y": 724
  },
  {
   "id": "T10a",
   "line": "They feared the fire.",
   "f_in": 2880,
   "f_out": 3060,
   "set": "black_top",
   "locked": "Many who raced said it should slow."
  },
  {
   "id": "T10b",
   "line": "They feared each other more.",
   "f_in": 2950,
   "f_out": 3060,
   "set": "black_bottom",
   "locked": "None would slow alone."
  },
  {
   "id": "T11",
   "line": "So the rest of us lit fires, to see by.",
   "f_in": 3210,
   "f_out": 3340,
   "set": "lower",
   "locked": "So the rest of us lit fires, to see by."
  },
  {
   "id": "T13",
   "line": "It took longer than anyone wanted.",
   "f_in": 5200,
   "f_out": 5320,
   "set": "lower",
   "locked": "It took longer than anyone wanted.",
   "x": 960,
   "y": 160
  },
  {
   "id": "T14",
   "line": "No one got there first.",
   "f_in": 6080,
   "f_out": 6200,
   "set": "lower",
   "locked": "No one got there first.",
   "x": 1420,
   "y": 570
  },
